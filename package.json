{
  "name": "local-file-searcher",
  "description": "本地文件内容搜索工具 (Local Full Text Search)",
  "private": true,
  "version": "2.0.0",
  "author": "贺文照",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); try{fs.rmSync('dist', {recursive:true, force:true});}catch(e){}\"",
    "lint": "tsc --noEmit",
    "electron:dev": "electron .",
    "electron:build": "node build-electron.cjs",
    "electron:build:win": "node build-electron.cjs",
    "electron:build:portable": "node build-electron.cjs --portable",
    "electron:build:mac": "vite build && electron-builder --mac --publish never",
    "electron:build:all": "vite build && electron-builder -mw --publish never"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.3",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
